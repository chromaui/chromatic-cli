#!/usr/bin/env bash
# control-chromatic — drive the locally built Chromatic CLI (dist/bin.cjs) and capture proof.
# Usage: control-chromatic <setup|rebuild|env|doctor|fixture|run|tty|cleanup> [...]
# Every run is scoped by RUN_ID (default: "default"); state lives in $VERIFY_ROOT/$RUN_ID.
set -euo pipefail

die() { echo "control-chromatic: $*" >&2; exit 2; }

# RUN_ID and labels become path components that cleanup deletes and tmux session names.
require_safe_name() {
  [[ "$2" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "$1 must contain only letters, digits, '_' or '-' (got '$2')"
}

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(cd "$SKILL_DIR/../../.." && pwd)"
RUN_ID="${RUN_ID:-default}"
require_safe_name RUN_ID "$RUN_ID"
VERIFY_ROOT="${VERIFY_ROOT:-${TMPDIR:-/tmp}/verify-chromatic-cli}"
RUN_DIR="$VERIFY_ROOT/$RUN_ID"
WORK="$RUN_DIR/work"            # disposable: removed by cleanup
EVIDENCE="$RUN_DIR/evidence"    # proof: survives cleanup
SB_DIR="$WORK/storybook-static" # this run's own Storybook build (never the repo's storybook-static/)
SB_STATS="$SB_DIR/preview-stats.json"
FIXTURE="$WORK/project"
CLI="$REPO/dist/bin.cjs"
TMUX_PREFIX="vcc-$RUN_ID-"
SESSIONS_FILE="$RUN_DIR/tmux-sessions"

# Yarn 4 comes from corepack; repo.yarnpkg.com can be blocked by egress policy, npm is not.
export COREPACK_NPM_REGISTRY="${COREPACK_NPM_REGISTRY:-https://registry.npmjs.org}"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
export STORYBOOK_DISABLE_TELEMETRY=1

cmd_env() {
  cat <<EOF
export RUN_ID='$RUN_ID'
export REPO='$REPO'
export RUN_DIR='$RUN_DIR'
export WORK='$WORK'
export EVIDENCE='$EVIDENCE'
export SB_DIR='$SB_DIR'
export SB_STATS='$SB_STATS'
export FIXTURE='$FIXTURE'
export CLI='$CLI'
EOF
}

cmd_setup() {
  mkdir -p "$WORK" "$EVIDENCE"
  cd "$REPO"
  corepack enable >/dev/null 2>&1 || true
  echo "==> yarn install --immutable"
  yarn install --immutable
  echo "==> yarn build"
  yarn build
  build_storybook
  echo "==> setup done for RUN_ID=$RUN_ID"
}

cmd_rebuild() {
  cd "$REPO"
  echo "==> yarn build"
  yarn build
  if [[ "${1:-}" == "--storybook" ]]; then build_storybook; fi
}

build_storybook() {
  mkdir -p "$WORK"
  echo "==> yarn build-storybook -o $SB_DIR"
  # stdin must be a pipe or TTY: with stdin=/dev/null the repo's clack-capture
  # Storybook plugin crashes with "process.stdin.unref is not a function".
  (cd "$REPO" && : | yarn build-storybook -o "$SB_DIR" > "$WORK/storybook-build.log" 2>&1) \
    || { tail -30 "$WORK/storybook-build.log"; die "storybook build failed (log: $WORK/storybook-build.log)"; }
  [[ -s "$SB_STATS" ]] || die "storybook build finished but $SB_STATS is missing"
  echo "    stats: $SB_STATS"
}

cmd_doctor() {
  local fail=0
  ok()   { echo "PASS  $*"; }
  bad()  { echo "FAIL  $*"; fail=1; }
  info() { echo "INFO  $*"; }

  local major; major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
  if (( major >= 22 )); then ok "node $(node -v) (>=22 required)"; else bad "node $(node -v 2>/dev/null || echo missing) — need >=22"; fi

  if [[ -f "$CLI" ]]; then
    local want got
    want="$(node -p "require('$REPO/package.json').version")"
    got="$(node "$CLI" --version 2>/dev/null || true)"
    if [[ "$got" == "$want" ]]; then ok "dist/bin.cjs --version = $got"; else bad "dist/bin.cjs --version = '$got', package.json = '$want'"; fi
    local newer
    newer="$(find "$REPO/bin-src" "$REPO/node-src" -type f -newer "$CLI" -not -name '*.test.ts' -not -name '*.stories.ts' 2>/dev/null | head -3)"
    if [[ -z "$newer" ]]; then ok "dist is newer than bin-src/ and node-src/"; else bad "dist is stale (newer sources: $(echo $newer | tr '\n' ' ')) — run: control-chromatic rebuild"; fi
  else
    bad "$CLI missing — run: control-chromatic setup"
  fi

  if [[ -s "$SB_STATS" ]]; then ok "run stats file $SB_STATS"; else bad "no stats for RUN_ID=$RUN_ID at $SB_STATS — run: control-chromatic setup (or rebuild --storybook)"; fi

  local index="${CHROMATIC_INDEX_URL:-https://index.chromatic.com}" code
  code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$index/graphql" 2>/dev/null || true)"
  if [[ "$code" =~ ^[1-4][0-9][0-9]$ && "$code" != "403" && "$code" != "407" ]]; then
    info "backend $index reachable (HTTP $code) — publish-build journeys possible"
  else
    info "backend $index NOT reachable (HTTP ${code:-none}) — publish-build journeys will fail at 'Authenticating'"
  fi
  if [[ -n "${CHROMATIC_PROJECT_TOKEN:-}" ]]; then info "CHROMATIC_PROJECT_TOKEN is set (value not shown)"; else info "CHROMATIC_PROJECT_TOKEN not set"; fi

  if [[ -s "$SESSIONS_FILE" ]]; then info "tmux sessions owned by this run: $(tr '\n' ' ' < "$SESSIONS_FILE")"; fi
  info "evidence dir: $EVIDENCE"
  return $fail
}

cmd_fixture() {
  # A disposable JS project + git repo, so CLI side files (chromatic.log, diagnostics,
  # chromatic.config.json) never land in the chromatic-cli checkout.
  rm -rf "$FIXTURE"; mkdir -p "$FIXTURE"
  cat > "$FIXTURE/package.json" <<'EOF'
{
  "name": "verify-chromatic-fixture",
  "private": true,
  "scripts": { "build-storybook": "echo fixture has no storybook && exit 1" }
}
EOF
  git -C "$FIXTURE" init -q
  git -C "$FIXTURE" -c user.email=verify@example.invalid -c user.name=verify add -A
  git -C "$FIXTURE" -c user.email=verify@example.invalid -c user.name=verify commit -q -m "fixture"
  echo "$FIXTURE"
}

# Evidence gets shared, so a token passed with -t never reaches command.txt verbatim.
redacted_args() {
  local redact_next=0 a
  for a in "$@"; do
    if (( redact_next )); then printf ' REDACTED'; redact_next=0; continue; fi
    case "$a" in
      -t|--project-token) printf ' %q' "$a"; redact_next=1 ;;
      -t=*|--project-token=*) printf ' %q' "${a%%=*}=REDACTED" ;;
      *) printf ' %q' "$a" ;;
    esac
  done
}

# record_command <out dir> <cwd> <mode suffix> <cli args...>
record_command() {
  local out="$1" cwd="$2" mode="$3"; shift 3
  printf 'cwd: %s\ncommand%s: node %s%s\n' "$cwd" "$mode" "$CLI" "$(redacted_args "$@")" > "$out/command.txt"
}

# run <label> [--cwd DIR] -- <cli args...>
cmd_run() {
  local label="${1:-}"; shift || true
  [[ -n "$label" ]] || die "run needs a label"
  require_safe_name label "$label"
  local cwd="$REPO"
  while [[ $# -gt 0 && "$1" != "--" ]]; do
    case "$1" in
      --cwd) cwd="$2"; shift 2 ;;
      *) die "unknown run option $1" ;;
    esac
  done
  [[ "${1:-}" == "--" ]] && shift
  local out="$EVIDENCE/$label"; mkdir -p "$out"
  record_command "$out" "$cwd" "" "$@"
  set +e
  # stdin is an empty pipe (non-TTY, never /dev/null) so the CLI takes its non-interactive path.
  (cd "$cwd" && : | node "$CLI" "$@" > "$out/stdout.txt" 2> "$out/stderr.txt")
  local code=$?
  set -e
  echo "$code" > "$out/exit_code"
  echo "== $label: exit $code  (evidence: $out)"
  echo "-- stdout ($(wc -l < "$out/stdout.txt") lines, first 40):"; head -40 "$out/stdout.txt"
  echo "-- stderr ($(wc -l < "$out/stderr.txt") lines, first 20):"; head -20 "$out/stderr.txt"
}

# tty <label> [--cwd DIR] [--timeout SECS] -- <cli args...>
cmd_tty() {
  local label="${1:-}"; shift || true
  [[ -n "$label" ]] || die "tty needs a label"
  require_safe_name label "$label"
  local cwd="$REPO" timeout=120
  while [[ $# -gt 0 && "$1" != "--" ]]; do
    case "$1" in
      --cwd) cwd="$2"; shift 2 ;;
      --timeout) timeout="$2"; shift 2 ;;
      *) die "unknown tty option $1" ;;
    esac
  done
  [[ "${1:-}" == "--" ]] && shift
  local out="$EVIDENCE/$label" session="${TMUX_PREFIX}${label}"; mkdir -p "$out"
  local argstr; argstr="$(printf ' %q' "$@")"
  record_command "$out" "$cwd" " (tty)" "$@"
  mkdir -p "$RUN_DIR"; echo "$session" >> "$SESSIONS_FILE"
  tmux new-session -d -s "$session" -x 120 -y 50 -c "$cwd" \
    "node '$CLI'$argstr; echo __VERIFY_EXIT=\$?; sleep 3600"
  local waited=0
  until tmux capture-pane -p -t "$session" -S - | grep -q '__VERIFY_EXIT='; do
    sleep 1; waited=$((waited + 1))
    (( waited < timeout )) || { tmux capture-pane -p -t "$session" -S - > "$out/pane.txt"; die "tty $label timed out after ${timeout}s (pane: $out/pane.txt)"; }
  done
  tmux capture-pane -p -t "$session" -S - > "$out/pane.txt"
  grep -o '__VERIFY_EXIT=[0-9]*' "$out/pane.txt" | tail -1 | cut -d= -f2 > "$out/exit_code"
  tmux kill-session -t "$session"
  echo "== $label (tty): exit $(cat "$out/exit_code")  (evidence: $out/pane.txt)"
  grep -v '^$' "$out/pane.txt" | head -40
}

# Diagnostics from an authenticated run hold the raw project token and session JWT
# under .analytics (CAP-5317), so strip it before evidence outlives the run.
scrub_evidence() {
  local f
  while IFS= read -r -d '' f; do
    jq -e 'type == "object" and has("analytics")' "$f" > /dev/null 2>&1 || continue
    jq 'del(.analytics)' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
    echo "scrubbed .analytics from $f"
  done < <(find "$EVIDENCE" -name '*.json' -type f -print0 2>/dev/null)
}

cmd_cleanup() {
  if [[ -s "$SESSIONS_FILE" ]]; then
    while read -r s; do tmux kill-session -t "$s" 2>/dev/null || true; done < "$SESSIONS_FILE"
    rm -f "$SESSIONS_FILE"
  fi
  rm -rf "$WORK"
  scrub_evidence
  echo "cleaned RUN_ID=$RUN_ID (removed $WORK; evidence kept)"
  if [[ -d "$EVIDENCE" ]]; then echo "evidence: $EVIDENCE"; ls "$EVIDENCE"; fi
}

sub="${1:-}"; shift || true
case "$sub" in
  setup) cmd_setup "$@" ;;
  rebuild) cmd_rebuild "$@" ;;
  env) cmd_env ;;
  doctor) cmd_doctor ;;
  fixture) cmd_fixture ;;
  run) cmd_run "$@" ;;
  tty) cmd_tty "$@" ;;
  cleanup) cmd_cleanup ;;
  *) sed -n '2,4p' "${BASH_SOURCE[0]}"; exit 2 ;;
esac
